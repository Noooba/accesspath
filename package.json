    "drizzle-orm": "0.45.4",
    "@libsql/client": "0.18.0",
    "zod": "4.6.7",
    "jose": "^6.1.0",
    "motion": "14.1.0",
    "lucide-react": "1.55.0",
    "@radix-ui/react-dialog": "1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
