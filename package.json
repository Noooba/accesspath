{
  "name": "accesspath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3050",
    "build": "next build",
    "start": "next start --port 3050",
