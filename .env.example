# Local development defaults to file:./data/accesspath.db. Do not use a file DB on Vercel.
DATABASE_URL=file:./data/accesspath.db
# Required only for a remote libSQL database; never prefix secrets with NEXT_PUBLIC_.
DATABASE_AUTH_TOKEN=
# Generate separate random secrets with at least 32 characters. No default admin login exists.
ADMIN_KEY=
SESSION_SECRET=
# Optional server-only overrides for compatible public HTTPS map providers.
# Defaults work for this low-volume prototype without an API key.
PHOTON_API_URL=https://photon.komoot.io/api/
FOOT_ROUTER_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot/
# Local access-aware graph lookup. Public capacity is limited; provision your own endpoint before substantial usage.
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
# Before hosting, identify your deployment/contact in this provider User-Agent.
LIVE_PROVIDER_USER_AGENT=AccessPath/0.2 (+https://accesspath-alpha.vercel.app; low-volume opt-in walking guidance)
